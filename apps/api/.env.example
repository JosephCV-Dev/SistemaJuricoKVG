# Solo configuración de la API. Copiar a apps/api/.env.
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3000

# Opcionales para arrancar health; configura ambas para integrar Supabase.
# URL y publishable key: diálogo Connect del proyecto de desarrollo.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# La clave técnica de archivos se documenta abajo y nunca se usa en el frontend.

# Origen visible del navegador; debe coincidir con la URL usada en desarrollo.
APP_ORIGIN=http://127.0.0.1:5173
TRUST_PROXY=false

# Configurar las tres juntas para habilitar identidad. El comando de preparación
# de desarrollo aprovisiona el rol limitado y genera las dos claves locales.
SESSION_DATABASE_URL=
SESSION_SECRET=
SESSION_ENCRYPTION_KEY=

# Solo herramientas de preparación y prueba en desarrollo; no son la conexión
# ordinaria de negocio ni se envían al frontend. No publicar valores reales.
# DATABASE_URL=postgresql://...

# CU008: el broker privado de archivos de la API y el trabajador requieren esta
# clave técnica exclusivamente para kvg_trabajar/Storage. Negocio sigue con JWT.
SUPABASE_SECRET_KEY=
# Por ahora las cargas nuevas están pausadas. No requiere antivirus para usar
# identidad, clientes, expedientes y documentos previamente verificados.
# verified exige trabajador y ClamAV reales; no omite el análisis.
DOCUMENT_UPLOAD_MODE=paused
# Configuración reservada para reactivar la verificación. No exponer el puerto.
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
